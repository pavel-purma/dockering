{
  "_comment": "Synthetic sanitised repair edge cases, not claimed live recordings. Shared inspect object is replayed verbatim by COM and CLI.",
  "sessions": ["repair-session"],
  "commands": {
    "version": {"stdout": "WSLC version: 3.0.1\n"},
    "system info --format json": {"stdout": "{}\n"},
    "container list --quiet": {"stdout": ""},
    "container stats repair-ports --format json": {"stdout":"{\"CPUPerc\":\"0.00%\",\"MemUsage\":\"1MiB / 1GiB\",\"NetIO\":\"0B / 0B\",\"BlockIO\":\"0B / 0B\",\"PIDs\":\"1\"}"},
    "image pull repair-rpc": {"stderr":"transport lost\nError code: RPC_S_CALL_FAILED\n","exit_code":1},
    "image pull repair-policy": {"stderr":"blocked\nError code: WSLC_E_REGISTRY_BLOCKED_BY_POLICY\n","exit_code":1},
    "image pull repair-domain": {"stderr":"Image not found\nError code: WSLC_E_IMAGE_NOT_FOUND\n","exit_code":1},
    "volume inspect --format json repair-a repair-b": {"stdout":"{broken-json"},
    "volume inspect --format json repair-denied repair-b": {"stderr":"disabled by policy\nError code: WSLC_E_CONTAINER_DISABLED\n","exit_code":1},
    "volume inspect --format json repair-missing repair-b": {"stderr":"Volume not found\nError code: WSLC_E_VOLUME_NOT_FOUND\n","exit_code":1},
    "volume inspect --format json repair-missing": {"stderr":"Volume not found\nError code: WSLC_E_VOLUME_NOT_FOUND\n","exit_code":1},
    "volume inspect --format json repair-b": {"stdout":"[{\"Name\":\"repair-b\",\"Driver\":\"guest\"}]"},
    "container list --all --no-trunc --format json": {"stdout": ""},
    "container inspect --format json repair-ports": {"stdout_file": "inspect_ports.json"},
    "container inspect --format json repair-running": {"stdout":"{\"Id\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"State\":{\"Running\":true,\"Status\":\"running\"},\"Config\":{}}"},
    "container inspect --format json repair-malformed": {"stdout": "{broken-json"},
    "image inspect --format json repair-malformed": {"stdout": "{broken-json"},
    "volume inspect --format json repair-malformed": {"stdout": "{broken-json"},
    "network inspect --format json repair-malformed": {"stdout": "{broken-json"},
    "container inspect --format json repair-blank": {"stdout": ""},
    "container inspect --format json repair-null": {"stdout": "null"},
    "container inspect --format json repair-scalar": {"stdout": "42"},
    "container inspect --format json repair-nonobject-array": {"stdout": "[null]"},
    "container inspect --format json repair-mixed-array": {"stdout": "[{},null]"},
    "container inspect --format json repair-empty": {"stdout": "[]"},
    "container inspect --format json repair-unknown": {"stdout": "{\"Id\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"Name\":\"/repair-unknown\",\"Config\":{},\"State\":{\"Status\":\"future-state\"},\"FutureField\":true}"},
    "container run --detach --name repair-lost-id hello-world:latest": {"stdout": "Created container but response ID was lost\n"},
    "container run --detach --name repair-elevation hello-world:latest": {"stderr": "The requested operation requires elevation.\nError code: ERROR_ELEVATION_REQUIRED\n", "exit_code": 1}
  }
}
