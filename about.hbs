<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dockering third-party licences</title>
  <style>
    :root { color-scheme: light dark; }
    body { font: 15px/1.5 system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
    h1, h2, h3, h4 { line-height: 1.2; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; background: rgba(127,127,127,.12); }
    .used-by { margin-top: -.5rem; }
  </style>
</head>
<body>
  <h1>Dockering third-party licences</h1>
  <p>Generated by <code>cargo about generate about.hbs</code>. The Dockering project itself is licensed under MIT OR Apache-2.0.</p>

  <h2>Manual asset and source notices</h2>
  <h3>Lucide icons</h3>
  <p>Lucide icons are distributed under the ISC License. Copyright (c) 2020, Lucide Contributors.</p>
  <h3>Vendored Microsoft WSL interface definitions</h3>
  <p>Vendored <code>wslc.idl</code> and <code>WSLCShared.idl</code> copies retain their upstream MIT headers and remain subject to those terms.</p>

  <h2>Dependency licence overview</h2>
  <ul>
  {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
  {{/each}}
  </ul>

  <h2>Licence texts</h2>
  {{#each licenses}}
    {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
    <h4>{{name}}</h4>
    <p class="used-by">Used by:</p>
    <ul>
    {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
